# Copy this file to .env for local development.
# Never commit real credentials or secret values.
SECRET_KEY=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_new_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback
# Optional: set these to a persistent disk path on your hosting provider.
# MEDIVAULT_DB=/var/data/medivault.db
# MEDIVAULT_UPLOADS=/var/data/private_uploads
